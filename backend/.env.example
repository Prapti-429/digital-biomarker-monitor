# ==============================================================================
# DIGITAL BIOMARKER MONITOR - ENVIRONMENT CONFIGURATION
# ==============================================================================

PROJECT_NAME="Digital Biomarker Monitor"
VERSION="1.0.0"
DEBUG=False

# Authentication / JWT -- use a long random value in Render.
JWT_SECRET_KEY=replace-with-a-long-random-production-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=digital_biomarker_db

# SQLAlchemy Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=False

# Optional AI-assisted document organization.
# Leave blank to use the safe local document-intelligence fallback.
# Never commit a real API key.
NUVYRA_DOCUMENT_AI_API_KEY=
NUVYRA_DOCUMENT_AI_BASE_URL=https://api.openai.com/v1
NUVYRA_DOCUMENT_AI_MODEL=gpt-4.1-mini
